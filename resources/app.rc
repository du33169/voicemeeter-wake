#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VoicemeeterEngineWake"
            VALUE "FileDescription", "Restart Voicemeeter audio engine when playback resumes after long silence (headphone wake-up)"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductName", "Voicemeeter Engine Wake"
            VALUE "ProductVersion", "0.1.0"
            VALUE "InternalName", "voicemeeter-engine-wake"
            VALUE "OriginalFilename", "voicemeeter-engine-wake.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
