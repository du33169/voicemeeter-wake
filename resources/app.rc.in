#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VMWAKE_VERSION_COMMA@,0
 PRODUCTVERSION @VMWAKE_VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "@VMWAKE_COMPANY@"
            VALUE "FileDescription", "@VMWAKE_DESCRIPTION@"
            VALUE "FileVersion", "@VMWAKE_VERSION@"
            VALUE "ProductName", "@VMWAKE_PRODUCT_NAME@"
            VALUE "ProductVersion", "@VMWAKE_VERSION@"
            VALUE "InternalName", "@VMWAKE_EXECUTABLE@"
            VALUE "OriginalFilename", "@VMWAKE_EXECUTABLE@.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
